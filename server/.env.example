# ReputationManager Environment Configuration - TEMPLATE
# 
# INSTRUCCIONES:
# 1. Copiar este archivo a .env
# 2. Actualizar valores según tu entorno
# 3. NO commitar .env a repositorio (incluir en .gitignore)
# 4. NUNCA usar credenciales de producción en desarrollo
#
# MODO DE ALMACENAMIENTO (elegir uno):
# - json: Usar JSON file storage (ACTUAL - Sin cambios)
# - postgresql: Usar PostgreSQL (FUTURO - No hasta Fase 3)

# ============================================================
# APLICACIÓN
# ============================================================
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# JWT Security
JWT_SECRET=9f8e7d6c5b4a3f2e1d0c9b8a7f6e5d4c3b2a1f0e9d8c7b6a5f4e3d2c1b0a

# ============================================================
# RATE LIMITING
# ============================================================
RATE_LIMIT_LOGIN=5
RATE_LIMIT_SIGNUP=3
RATE_LIMIT_REVIEWS=3

# ============================================================
# ALMACENAMIENTO (NO CAMBIAR AÚN - FASE 3)
# ============================================================
# STORAGE_TYPE=json

# ============================================================
# BASE DE DATOS - PostgreSQL (PARA FASE 2 PREPARACIÓN)
# ============================================================
# IMPORTANTE: No cambiar estos valores hasta autorización
# Estos son SOLO para desarrollo local
#
# Host: Puede ser 'localhost' si PostgreSQL está en la misma máquina
# Port: 5432 es el default de PostgreSQL
# User: 'postgres' es el usuario default (cambiar en producción)
# Password: Cambiar después de instalar
# Database: 'reputation_manager_dev' para desarrollo

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=reputation_manager_dev
DB_SSL=false

# ============================================================
# REDIS (OPCIONAL - Fase 3+)
# ============================================================
# Será usado para rate limiting distribuido
# Por ahora, express-rate-limit usa memory store
# REDIS_URL=redis://localhost:6379

# ============================================================
# LOGGING
# ============================================================
LOG_LEVEL=debug

# ============================================================
# NOTAS IMPORTANTES
# ============================================================
# 1. Este archivo es un TEMPLATE
# 2. Copiar a .env antes de usar
# 3. Los valores son para DESARROLLO SOLO
# 4. NUNCA usar en producción sin revisar seguridad
# 5. NUNCA incluir secretos reales en repositorio
