# ReputationManager - Environment Configuration (PRODUCTION)
#
# INSTRUCCIONES:
# 1. NUNCA versionar este archivo con valores reales
# 2. Inyectar estas variables en el servidor de producción:
#    - Via variables de entorno del sistema operativo
#    - Via archivo .env generado por deployment script
#    - Via secrets manager (AWS Secrets, HashiCorp Vault, etc.)
# 3. Ver .env.example para descripción de cada variable
#
# VALIDACIÓN:
# - Todas las variables son OBLIGATORIAS en staging/production
# - El servidor fallará al startup si faltan variables
# - Los valores deben ser únicos por ambiente

# ============================================================
# APLICACIÓN
# ============================================================
PORT=5005
NODE_ENV=production
CORS_ORIGIN=https://app.example.com,https://www.app.example.com

# JWT Security - GENERAR CON: openssl rand -hex 32
JWT_SECRET=<generar_con_openssl_rand_hex_32_DEBE_SER_UNICO>

# ============================================================
# RATE LIMITING (Ajustar según carga esperada)
# ============================================================
RATE_LIMIT_LOGIN=5
RATE_LIMIT_SIGNUP=3
RATE_LIMIT_REVIEWS=3
RATE_LIMIT_PUBLIC=100

# ============================================================
# BASE DE DATOS - PostgreSQL (OBLIGATORIAS)
# ============================================================
# IMPORTANTE: Usar credenciales seguras, diferentes por ambiente
# - NO usar 'postgres' como password
# - NO usar valores de desarrollo
# - Host puede ser RDS, managed DB, o servidor privado
# - Puerto típicamente 5432 para conexiones externas
# - DB_SSL debería ser 'true' para conexiones remotas

DB_HOST=prod-db-hostname-or-ip.example.com
DB_PORT=5432
DB_USER=reputation_prod_user
DB_PASSWORD=<generar_contraseña_segura_64_caracteres_minimo>
DB_NAME=reputation_manager_prod
DB_SSL=true

# ============================================================
# LOGGING (Opcional)
# ============================================================
LOG_LEVEL=warn
