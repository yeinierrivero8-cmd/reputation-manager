import 'dotenv/config';
import express from 'express';
import cors from 'cors';
import bcrypt from 'bcryptjs';
import jwt from 'jsonwebtoken';
import { nanoid } from 'nanoid';
import fs from 'node:fs/promises';
import path from 'node:path';
import { fileURLToPath } from 'node:url';
import rateLimit from 'express-rate-limit';

const __dirname = path.dirname(fileURLToPath(import.meta.url));
const DATA_DIR = path.resolve(__dirname, '../data');
const DB_FILE = path.join(DATA_DIR, 'db.json');
const PORT = process.env.PORT || 5000;
const NODE_ENV = process.env.NODE_ENV || 'development';
const JWT_SECRET = process.env.JWT_SECRET;
const CORS_ORIGIN = process.env.CORS_ORIGIN || 'http://localhost:5173,http://localhost:3000';

if (!JWT_SECRET) {
  if (NODE_ENV === 'production') {
    console.error('❌ FATAL: JWT_SECRET not configured. Set it in .env and restart.');
    process.exit(1);
  } else {
    console.warn('⚠️ WARNING: JWT_SECRET not set. Using unsafe default for development only.');
  }
}

const app = express();

const corsOptions = {
  origin: CORS_ORIGIN.split(',').map(o => o.trim()),
  credentials: true,
  methods: ['GET', 'POST', 'PUT', 'DELETE']
};
app.use(cors(corsOptions));
app.use(express.json({ limit: '1mb' }));

const loginLimiter = rateLimit({
  windowMs: 15 * 60 * 1000,
  max: parseInt(process.env.RATE_LIMIT_LOGIN || '5'),
  message: 'Demasiados intentos de inicio de sesión. Intenta de nuevo en 15 minutos.',
  standardHeaders: true,
  legacyHeaders: false,
  skip: (req) => NODE_ENV !== 'production'
});

const signupLimiter = rateLimit({
  windowMs: 60 * 60 * 1000,
  max: parseInt(process.env.RATE_LIMIT_SIGNUP || '3'),
  message: 'Demasiados intentos de registro. Intenta de nuevo en 1 hora.',
  standardHeaders: true,
  legacyHeaders: false,
  skip: (req) => NODE_ENV !== 'production'
});

const reviewLimiter = rateLimit({
  windowMs: 60 * 1000,
  max: parseInt(process.env.RATE_LIMIT_REVIEWS || '3'),
  message: 'Demasiadas reseñas. Espera antes de enviar otra.',
  standardHeaders: true,
  legacyHeaders: false,
  skip: (req) => NODE_ENV !== 'production'
});

let dbWriteLock = false;
let writeQueue = [];

async function readDB() {
  await fs.mkdir(DATA_DIR, { recursive: true });
  try { return JSON.parse(await fs.readFile(DB_FILE, 'utf8')); }
  catch { const initial = { users: [], businesses: [], reviews: [] }; await writeDB(initial); return initial; }
}

async function writeDB(db) {
  await fs.mkdir(DATA_DIR, { recursive: true });
  return new Promise((resolve, reject) => {
    writeQueue.push(async () => {
      try {
        const tmp = DB_FILE + '.tmp';
        await fs.writeFile(tmp, JSON.stringify(db, null, 2), 'utf8');
        await fs.rename(tmp, DB_FILE);
        resolve();
      } catch (e) {
        console.error('❌ Database write error:', e.message);
        reject(e);
      }
    });
    processWriteQueue();
  });
}

async function processWriteQueue() {
  if (dbWriteLock || writeQueue.length === 0) return;
  dbWriteLock = true;
  while (writeQueue.length > 0) {
    const task = writeQueue.shift();
    try {
      await task();
    } catch (e) {
      console.error('Write queue error:', e);
    }
  }
  dbWriteLock = false;
}
const safeUser = (u) => ({ id: u.id, name: u.name, email: u.email, createdAt: u.createdAt });
function auth(req, res, next) {
  const token = (req.headers.authorization || '').replace(/^Bearer\s+/i, '');
  if (!token) return res.status(401).json({ message: 'Inicia sesión para continuar.' });
  try { req.user = jwt.verify(token, JWT_SECRET); next(); }
  catch { return res.status(401).json({ message: 'Tu sesión expiró. Inicia sesión de nuevo.' }); }
}
function ownedBusiness(db, userId, businessId) { return db.businesses.find(b => b.id === businessId && b.userId === userId); }

app.get('/api/health', (_req, res) => res.json({ ok: true, name: 'ReputationManager API' }));
app.post('/api/auth/signup', signupLimiter, async (req, res) => {
  try {
    const name = String(req.body.name || '').trim(); const email = String(req.body.email || '').trim().toLowerCase(); const password = String(req.body.password || '');
    if (name.length < 2) return res.status(400).json({ message: 'Escribe tu nombre completo.' });
    if (!/^\S+@\S+\.\S+$/.test(email)) return res.status(400).json({ message: 'Escribe un correo válido.' });
    if (password.length < 8) return res.status(400).json({ message: 'La contraseña debe tener al menos 8 caracteres.' });
    const db = await readDB(); if (db.users.some(u => u.email === email)) return res.status(409).json({ message: 'Ya existe una cuenta con ese correo. Inicia sesión.' });
    const user = { id: nanoid(14), name, email, passwordHash: await bcrypt.hash(password, 12), createdAt: new Date().toISOString() };
    db.users.push(user); await writeDB(db);
    const token = jwt.sign({ id: user.id, email: user.email }, JWT_SECRET, { expiresIn: '7d' });
    res.status(201).json({ token, user: safeUser(user) });
  } catch (e) { console.error(e); res.status(500).json({ message: 'No se pudo crear la cuenta. Inténtalo de nuevo.' }); }
});
app.post('/api/auth/login', loginLimiter, async (req, res) => {
  try {
    const email = String(req.body.email || '').trim().toLowerCase(); const password = String(req.body.password || ''); const db = await readDB();
    const user = db.users.find(u => u.email === email);
    if (!user || !(await bcrypt.compare(password, user.passwordHash))) return res.status(401).json({ message: 'Correo o contraseña incorrectos.' });
    const token = jwt.sign({ id: user.id, email: user.email }, JWT_SECRET, { expiresIn: '7d' }); res.json({ token, user: safeUser(user) });
  } catch (e) { console.error(e); res.status(500).json({ message: 'No se pudo iniciar sesión.' }); }
});
app.get('/api/auth/me', auth, async (req, res) => { const db = await readDB(); const user = db.users.find(u => u.id === req.user.id); if (!user) return res.status(404).json({ message: 'Usuario no encontrado.' }); res.json({ user: safeUser(user) }); });
app.get('/api/dashboard', auth, async (req, res) => {
  const db = await readDB(); const businesses = db.businesses.filter(b => b.userId === req.user.id).map(b => {
    const reviews = db.reviews.filter(r => r.businessId === b.id); const averageRating = reviews.length ? Math.round(reviews.reduce((s, r) => s + r.rating, 0) / reviews.length * 10) / 10 : 0;
    return { ...b, averageRating, totalReviews: reviews.length };
  });
  const businessIds = new Set(businesses.map(b => b.id)); const reviews = db.reviews.filter(r => businessIds.has(r.businessId)).sort((a,b) => new Date(b.createdAt)-new Date(a.createdAt)).slice(0, 8).map(r => ({ ...r, businessName: businesses.find(b => b.id === r.businessId)?.name || 'Negocio' }));
  const totalReviews = reviews.length + db.reviews.filter(r => businessIds.has(r.businessId)).length - reviews.length;
  const all = db.reviews.filter(r => businessIds.has(r.businessId)); const averageRating = all.length ? Math.round(all.reduce((s,r)=>s+r.rating,0)/all.length*10)/10 : 0;
  res.json({ businesses, recentReviews: reviews, stats: { businesses: businesses.length, totalReviews, averageRating, fiveStars: all.filter(r=>r.rating===5).length } });
});
app.post('/api/businesses', auth, async (req, res) => {
  const name = String(req.body.name || '').trim(); const type = String(req.body.type || 'Otro').trim(); const description = String(req.body.description || '').trim();
  if (name.length < 2) return res.status(400).json({ message: 'El nombre del negocio debe tener al menos 2 caracteres.' });
  const db = await readDB(); const business = { id: nanoid(14), userId: req.user.id, name: name.slice(0,100), type: type.slice(0,50), description: description.slice(0,300), shareLink: nanoid(10), createdAt: new Date().toISOString() };
  db.businesses.push(business); await writeDB(db); res.status(201).json({ business: { ...business, averageRating: 0, totalReviews: 0 } });
});
app.put('/api/businesses/:id', auth, async (req, res) => {
  const db = await readDB(); const b = ownedBusiness(db, req.user.id, req.params.id); if (!b) return res.status(404).json({ message: 'Negocio no encontrado.' });
  if (req.body.name) b.name = String(req.body.name).trim().slice(0,100); if (req.body.type) b.type = String(req.body.type).trim().slice(0,50); if (typeof req.body.description === 'string') b.description = req.body.description.slice(0,300); await writeDB(db); res.json({ business: b });
});
app.delete('/api/businesses/:id', auth, async (req, res) => {
  const db = await readDB(); const b = ownedBusiness(db, req.user.id, req.params.id); if (!b) return res.status(404).json({ message: 'Negocio no encontrado.' });
  db.businesses = db.businesses.filter(x => x.id !== b.id); db.reviews = db.reviews.filter(r => r.businessId !== b.id); await writeDB(db); res.json({ ok: true });
});
app.get('/api/reviews', auth, async (req, res) => {
  const db = await readDB(); const ids = new Set(db.businesses.filter(b=>b.userId===req.user.id).map(b=>b.id));
  res.json({ reviews: db.reviews.filter(r=>ids.has(r.businessId)).sort((a,b)=>new Date(b.createdAt)-new Date(a.createdAt)).map(r=>({...r,businessName:db.businesses.find(b=>b.id===r.businessId)?.name || 'Negocio'})) });
});
app.get('/api/public/business/:shareLink', async (req, res) => {
  const db = await readDB(); const b = db.businesses.find(x => x.shareLink === req.params.shareLink); if (!b) return res.status(404).json({ message: 'No encontramos este negocio. Pide al establecimiento un enlace actualizado.' });
  const reviews = db.reviews.filter(r=>r.businessId===b.id); const averageRating = reviews.length ? Math.round(reviews.reduce((s,r)=>s+r.rating,0)/reviews.length*10)/10 : 0;
  res.json({ business: { name: b.name, type: b.type, description: b.description, shareLink: b.shareLink, averageRating, totalReviews: reviews.length }, reviews: reviews.sort((a,c)=>new Date(c.createdAt)-new Date(a.createdAt)).slice(0,5).map(r=>({ author: r.author, rating: r.rating, text: r.text, createdAt: r.createdAt })) });
});
app.post('/api/public/business/:shareLink/reviews', reviewLimiter, async (req, res) => {
  const author = String(req.body.author || '').trim(); const text = String(req.body.text || '').trim(); const rating = Number(req.body.rating);
  if (author.length < 2) return res.status(400).json({ message: 'Escribe tu nombre.' });
  if (!Number.isInteger(rating) || rating < 1 || rating > 5) return res.status(400).json({ message: 'Selecciona una calificación de 1 a 5 estrellas.' });
  if (text.length < 5) return res.status(400).json({ message: 'Cuéntanos un poco más sobre tu experiencia (mínimo 5 caracteres).' });
  if (text.length > 1500) return res.status(400).json({ message: 'La reseña no puede superar los 1.500 caracteres.' });
  const db = await readDB(); const b = db.businesses.find(x=>x.shareLink===req.params.shareLink); if (!b) return res.status(404).json({ message: 'Este enlace de reseñas no es válido.' });
  const review = { id: nanoid(14), businessId: b.id, author: author.slice(0,80), rating, text, platform: 'ReputationManager', createdAt: new Date().toISOString() }; db.reviews.push(review); await writeDB(db); res.status(201).json({ message: '¡Gracias por compartir tu experiencia!', review });
});
app.use((err, _req, res, _next) => { console.error(err); res.status(500).json({ message: 'Ocurrió un error inesperado.' }); });
app.listen(PORT, () => {
  console.log(`🚀 ReputationManager API en http://localhost:${PORT}`);
  console.log(`📋 Environment: ${NODE_ENV}`);
  console.log(`🔐 JWT Secret: ${JWT_SECRET ? '✅ Configured' : '❌ WARNING: Using unsafe default'}`);
  console.log(`🛡️  Rate limiting: ${NODE_ENV === 'production' ? '✅ Enabled' : '⏸️ Disabled in development'}`);
});
